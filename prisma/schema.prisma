// ApparelFlow ERP — Prisma schema (PostgreSQL / Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  cutting_supervisor
  cutting_verifier
  sewing_supervisor
}

enum OrderStatus {
  CUTTING_IN_PROGRESS
  PENDING_VERIFICATION
  REJECTED
  VERIFIED
  SEWING_STARTED
}

enum VerificationItemStatus {
  GREEN
  YELLOW
  RED
}

enum VerificationDecision {
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at")

  cuttingOrders    CuttingOrder[]    @relation("OrderCreator")
  sewingStartedOrders CuttingOrder[] @relation("SewingStarter")
  verificationLogs VerificationLog[]

  @@map("users")
}

model Recipe {
  id             String   @id @default(cuid())
  recipeCode     String   @unique @map("recipe_code")
  name           String
  category       String
  stdFabricYards Decimal  @map("std_fabric_yards") @db.Decimal(10, 2)
  wastageCap     Decimal  @map("wastage_cap") @db.Decimal(5, 2)

  components    RecipeComponent[]
  cuttingOrders CuttingOrder[]

  @@map("recipes")
}

model RecipeComponent {
  id               String  @id @default(cuid())
  recipeId         String  @map("recipe_id")
  componentName    String  @map("component_name")
  piecesPerGarment Int     @map("pieces_per_garment")
  imageUrl         String? @map("image_url")

  recipe             Recipe              @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  verificationItems  VerificationItem[]

  @@map("recipe_components")
}

model CuttingOrder {
  id              String      @id @default(cuid())
  orderNo         String      @unique @map("order_no")
  recipeId        String      @map("recipe_id")
  targetQty       Int         @map("target_qty")
  fabricRollId    String      @map("fabric_roll_id")
  actualFabricYds Decimal     @map("actual_fabric_yds") @db.Decimal(12, 2)
  status          OrderStatus @default(CUTTING_IN_PROGRESS)
  createdById     String      @map("created_by")
  sewingStartedBy String?     @map("sewing_started_by")
  sewingStartedAt DateTime?   @map("sewing_started_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  recipe            Recipe             @relation(fields: [recipeId], references: [id])
  createdBy         User               @relation("OrderCreator", fields: [createdById], references: [id])
  sewingStarter     User?              @relation("SewingStarter", fields: [sewingStartedBy], references: [id])
  verificationItems VerificationItem[]
  verificationLogs  VerificationLog[]

  @@index([status])
  @@map("cutting_orders")
}

model VerificationItem {
  id          String                  @id @default(cuid())
  orderId     String                  @map("order_id")
  componentId String                  @map("component_id")
  expectedQty Int                     @map("expected_qty")
  actualQty   Int?                    @map("actual_qty")
  status      VerificationItemStatus?

  order     CuttingOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  component RecipeComponent @relation(fields: [componentId], references: [id])

  @@unique([orderId, componentId])
  @@map("verification_items")
}

/// Insert-only audit trail — never update or delete rows in application code.
model VerificationLog {
  id                 String               @id @default(cuid())
  orderId            String               @map("order_id")
  verifierId         String               @map("verifier_id")
  decision           VerificationDecision
  rejectionNote      String?              @map("rejection_note")
  wastagePct         Decimal              @map("wastage_pct") @db.Decimal(8, 4)
  componentVariances Json                 @map("component_variances")
  timestamp          DateTime             @default(now())

  order    CuttingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifier User         @relation(fields: [verifierId], references: [id])

  @@map("verification_logs")
}
